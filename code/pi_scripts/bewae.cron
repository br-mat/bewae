# ─────────────────────────────────────────────────────────────────────────────
# bewae irrigation — Raspberry Pi 5 — /home/homepi/bewae
# Times are local Pi time (CET/CEST, Europe/Vienna)
# Uses Heimdall venv: /home/homepi/heimdall/venv
# Last updated: 2026-05-09
# ─────────────────────────────────────────────────────────────────────────────
#
# Verify after install with: crontab -l

# ── Environment ──────────────────────────────────────────────────────────────
# Weather forecast - 5 days ahead, 3-hour steps
10 */3 * * *  cd /home/homepi/bewae && /home/homepi/heimdall/venv/bin/python3 store_weather_forecast.py       >> /home/homepi/bewae/cron.log 2>&1

# ── Irrigation ───────────────────────────────────────────────────────────────
# Weather multiplier - once daily from next 24h forecast
0  6  * * *  cd /home/homepi/bewae && /home/homepi/heimdall/venv/bin/python3 calculate_weather_multiplier.py >> /home/homepi/bewae/cron.log 2>&1
# Soil moisture override - runs after weather multiplier so wet soil can force wm=0
5  6  * * *  cd /home/homepi/bewae && /home/homepi/heimdall/venv/bin/python3 check_soil_moisture.py          >> /home/homepi/bewae/cron.log 2>&1
